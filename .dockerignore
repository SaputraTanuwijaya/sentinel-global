# VCS / editor / OS
.git
.gitignore
.DS_Store
*.log

# Secrets — pass at runtime via --env-file or fly secrets, never bake in
.env
.env.*

# Local Claude config / human-facing docs / dev scripts
.claude
docs
README.md
LICENSE
sentinel.sh

# Installed deps + TS incremental cache — rebuilt fresh in the builder stage
node_modules
tsconfig.tsbuildinfo
dist

# Built client artifacts — regenerated by `bun run build` so the image
# always ships a minified bundle from current source, not a stale dev copy
src/public/js/index.js
src/public/js/admin.js
src/public/styles.css

# Docker artifacts themselves
Dockerfile
.dockerignore
